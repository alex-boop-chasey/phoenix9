#!/usr/bin/env python3
"""Stand-in for /usr/local/bin/proj in tests. Never touches real projects.

Env:
  FAKE_PROJ_LIST   file whose contents `list --json` prints (missing file -> failure)
  FAKE_PROJ_LOG    file; each call appends `run <argv as JSON>` and, when finished, `end <argv>`
  FAKE_PROJ_EXIT   non-zero: open/new fail with this exit code
  FAKE_PROJ_SLEEP  seconds open/new wait before acting (to test timeouts and the lock)
Messages copy the real proj's wording.
"""
import json
import os
import sys
import time

args = sys.argv[1:]


def log(kind):
    path = os.environ.get("FAKE_PROJ_LOG")
    if path:
        with open(path, "a") as f:
            f.write(f"{kind} {json.dumps(args)}\n")


def say(msg):
    print(f"proj: {msg}")


def die(msg):
    print(f"proj: {msg}", file=sys.stderr)
    log("end")
    sys.exit(1)


def load_list():
    with open(os.environ["FAKE_PROJ_LIST"]) as f:
        return f.read()


log("run")
cmd = args[0] if args else ""

if cmd == "list" and args[1:] == ["--json"]:
    try:
        sys.stdout.write(load_list())
    except OSError as e:
        die(f"can't read list: {e}")
    log("end")
    sys.exit(0)

time.sleep(float(os.environ.get("FAKE_PROJ_SLEEP") or 0))
code = int(os.environ.get("FAKE_PROJ_EXIT") or 0)
if code:
    print("proj: fake failure", file=sys.stderr)
    log("end")
    sys.exit(code)

projects = {p["name"]: p for p in json.loads(load_list())["projects"]}
name = args[1] if len(args) > 1 else ""

if cmd == "open":
    if name not in projects:
        die(f"no project '{name}'. See: proj list")
    if projects[name]["state"] == "on":
        say(f"{name} is already on.")
    else:
        say(f"{name} is on. It shows up in the Claude app in a few seconds; start a chat there.")
elif cmd == "new":
    if name in projects:
        die(f"'{name}' already exists")
    say(f"created /srv/projects/{name}")
    say(f"{name} is on. It shows up in the Claude app in a few seconds; start a chat there.")
else:
    die(f"unknown command '{cmd}'. See: proj help")

log("end")
